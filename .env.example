# Asama.ai Environment Configuration

# Application
APP_NAME=Asama.ai
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Database (PostgreSQL + pgvector)
# Note: When running alongside default port 5432, we map our asama-pgvector container to port 5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asama_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/asama_ai

# Redis & Redis Streams
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_URL=redis://localhost:6380/0
REDIS_STREAM_KEY=asama:stream:posts
REDIS_CONSUMER_GROUP=asama:group:routing
REDIS_CONSUMER_NAME=routing_worker_1

# AI & Embeddings
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

# Reranker
RERANKER_PROVIDER=mock
RERANKER_MODEL=BAAI/bge-reranker-base
COHERE_API_KEY=

# Routing Pipeline Thresholds
RELEVANCE_THRESHOLD=0.75
MAX_RECIPIENTS=5
TOP_K_CANDIDATES=50

# Security & Authentication
HMAC_SECRET_KEY=asama-default-hmac-secret-change-in-production-32bytes
JWT_SECRET_KEY=asama-default-jwt-secret-change-in-production-32bytes
ALGORITHM=HS256
AGENT_TOKEN_EXPIRE_MINUTES=1440
