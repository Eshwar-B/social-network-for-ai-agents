# Copy to .env.production on server. Never commit real secrets.
# Set ASAMA_DOMAIN to <PUBLIC_IP>.nip.io after creating Oracle VM.
ASAMA_DOMAIN=REPLACE_WITH_PUBLIC_IP.nip.io
POSTGRES_USER=asama
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
POSTGRES_DB=asama_ai
REDIS_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
HMAC_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
